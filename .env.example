# ==============================================================================
# AI Website Bot Builder — Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your real .env or .env.local file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Public Client & Server)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Supabase Service Role Key (SERVER-ONLY - CRITICAL SECRET)
# ------------------------------------------------------------------------------
# Required for server-side administrative tasks and bypassing RLS when authorized.
# NEVER expose this key in client-side code or public repositories.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Upstash Redis Configuration (SERVER-ONLY - Rate Limiting & Cost Protection)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL and Token for distributed rate limiting on /api/chat,
# /api/analyze, and /api/knowledge/upload.
# If omitted in development, an in-memory fallback will be used with a warning.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_your_upstash_redis_token...

# ------------------------------------------------------------------------------
# 4. Google Gemini API (SERVER-ONLY - Production AI & Embeddings)
# ------------------------------------------------------------------------------
# Required for Google Gemini LLM responses and text-embedding-004 vectors (Phase 2).
# Obtain from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. Legacy / Phase 1 Temporary AI Providers
# ------------------------------------------------------------------------------
# Temporary Groq API Key used in Phase 1 for chat and business analysis
GROQ_API_KEY=gsk_...
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Optional local Ollama model override (Phase 1 legacy embedding)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
