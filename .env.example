# ==============================================================================
# AI Website Bot Builder — Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your real .env or .env.local file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Public Client & Server)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable Key (Safe for browser client)
# Supports new 'sb_publishable_...' keys and legacy 'anon' JWT keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy fallback (optional if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is set):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Supabase Secret Key (SERVER-ONLY - CRITICAL SECRET)
# ------------------------------------------------------------------------------
# Required for server-side administrative tasks and bypassing RLS when authorized.
# Supports new 'sb_secret_...' keys and legacy 'service_role' JWT keys.
# NEVER expose this key in client-side code or public repositories.
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy fallback (optional if SUPABASE_SECRET_KEY is set):
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Upstash Redis Configuration (SERVER-ONLY - Rate Limiting & Cost Protection)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL and Token for distributed rate limiting on /api/chat,
# /api/analyze, and /api/knowledge/upload.
# If omitted in development, an in-memory fallback will be used with a warning.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_your_upstash_redis_token...

# ------------------------------------------------------------------------------
# 4. Google Gemini API (SERVER-ONLY - Production AI & Embeddings)
# ------------------------------------------------------------------------------
# Required for Google Gemini chat streaming, analysis, and vector embeddings (Phase 2).
# Obtain an API key from Google AI Studio (https://aistudio.google.com/).
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Optional model overrides (Defaults: gemini-3.8-flash, gemini-embedding-2)
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2

